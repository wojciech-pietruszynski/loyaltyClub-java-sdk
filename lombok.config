# Katalog glowny konfiguracji Lomboka dla calego repozytorium.
config.stopBubbling = true

# Lombok 1.18.4x widzi na sciezce Jacksona 2 i 3 i bez tej wskazowki ostrzega przy @Jacksonized.
# SDK celuje w Jacksona 2.x, bo tej wersji uzywa backend i wiekszosc aplikacji hostujacych.
lombok.jacksonized.jacksonVersion += 2

# Ulatwia narzedziom pokrycia kodu pomijanie metod wygenerowanych przez Lomboka.
lombok.addLombokGeneratedAnnotation = true
